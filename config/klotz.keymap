//                                      █        █ █      ▄▀            ▀▄      █         █
//                                      █       █  █    ▄▀                ▀▄    █        █
//                                      █      █   █   █                    █   █       █
//                                      █     █    █   █                    █   █      █
//                                      █    █     █   █                    █   █  ▀▀▀█▀▀▀▀
//                                      █   █ █    █   █                    █   █    █
//                                      █  █   █   █   █                    █   █   █
//                                      █ █     █  █    ▀▄                ▄▀    █  █
//                                      ██       █ █      ▀▄            ▄▀      █ █
//                                      █         ██▄▄▄▄▄▄▄▄█▄▄▄▄▄▄▄▄▄▄▀        ██▄▄▄▄▄▄▄▄▄▄
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define ETC 4
#define FAST 5

// --- Mouse Settings (기존 유지) ---

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&mmv_input_listener {
    compatible = "zmk,input-listener";
    device = <&mmv>;

    fast {
        layers = <FAST>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&mt {
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

&lt {
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

/ {
    /* 1. LED 인디케이터 설정 추가 */

    led_indicators {
        compatible = "zmk,control-led-indicator";

        // BASE 레이어 (D3 LED)

        layer_base {
            led = <&led_d3>;
            usage = "layer-state";
            layers = <BASE>;
        };

        // NAV 레이어 (D4 LED)

        layer_nav {
            led = <&led_d4>;
            usage = "layer-state";
            layers = <NAV>;
        };

        // SYM 레이어 (D5 LED)

        layer_sym {
            led = <&led_d5>;
            usage = "layer-state";
            layers = <SYM>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <30 31>;
            layers = <0>;
        };

        mouse {
            bindings = <&tog 4>;
            key-positions = <32 31 30 33>;
            layers = <0 4>;
        };
    };

    behaviors {
        lt_mt: long_tap_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <220>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q          &kp W          &kp E           &kp R            &kp T      &kp Y            &kp U           &kp I                  &kp O              &kp P
&lt_mt LGUI A  &lt_mt LALT S  &lt_mt LCTRL D  &lt_mt LSHIFT F  &kp G      &kp H            &lt_mt RSHFT J  &lt_mt LEFT_CONTROL K  &lt_mt LEFT_ALT L  &kp SEMICOLON
&kp Z          &kp X          &kp C           &kp V            &kp B      &kp N            &kp M           &kp COMMA              &kp DOT            &kp FSLH
                                              &lt 4 DELETE     &lt 1 RET  &lt 2 BACKSPACE  &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        nav_layer {
            label = "NAVI";
            bindings = <
&trans      &trans    &kp UP    &kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &kp KP_PLUS      &kp N7            &kp UP_ARROW  &kp CAPS         &kp ESC
&caps_word  &kp LEFT  &kp DOWN  &kp RIGHT         &trans           &kp KP_MINUS     &kp LEFT_ARROW    &kp DOWN      &kp RIGHT_ARROW  &kp PG_UP
&kp LSHFT   &trans    &trans    &trans            &trans           &kp KP_MULTIPLY  &kp N1            &kp N2        &kp N3           &kp PG_DN
                                &trans            &trans           &mo 3            &kp LEFT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&kp TILDE  &kp LT     &kp GT     &kp DQT    &kp SQT    &kp GRAVE  &kp AMPS  &kp LBKT  &kp RBKT  &kp PRCNT
&kp EXCL   &kp MINUS  &kp PLUS   &kp EQUAL  &kp HASH   &kp PIPE   &kp DLLR  &kp LPAR  &kp RPAR  &kp QMARK
&kp CARET  &kp FSLH   &kp ASTRK  &kp BSLH   &kp UNDER  &kp COLON  &kp DOT   &kp LBRC  &kp RBRC  &kp AT
                                 &trans     &mo 3      &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &out OUT_TOG  &trans  &trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&bt BT_CLR    &bt BT_NXT    &none         &trans  &trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans        &bt BT_PRV    &trans        &trans  &trans  &kp F11  &kp F12  &trans  &trans  &trans
                                          &trans  &trans  &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        etc_layer {
            label = "ETC";
            bindings = <
&none         &kp LC(A)     &kp LC(C)         &kp LC(V)       &none      &msc SCRL_UP    &none            &mmv MOVE_UP    &none            &none
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none      &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
&none         &none         &none             &none           &none      &msc SCRL_LEFT  &msc SCRL_RIGHT  &none           &none            &none
                                              &mo 5           &mkp MCLK  &mkp MB1        &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fast_layer {
            label = "FAST";
            bindings = <
&none         &kp LC(A)     &kp LC(C)         &kp LC(V)       &none      &msc SCRL_UP    &none            &mmv MOVE_UP    &none            &none
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none      &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
&none         &none         &none             &none           &none      &msc SCRL_LEFT  &msc SCRL_RIGHT  &none           &none            &none
                                              &trans          &mkp MCLK  &mkp MB1        &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };
    };
};
